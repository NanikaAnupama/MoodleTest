{{!
    @template local_helloworld/messages

    List of all messages on the Hello World page.

    Context variables required for this template:
    * hasmessages - Whether there is at least one message.
    * messages - The messages, each with:
        * name - First name of the person who posted it.
        * time - When it was posted, already formatted as a date.
        * message - The message text.
        * candelete - Whether the current user may delete it.
        * deleteurl - Address that starts deleting this message.

    Example context (json):
    {
        "hasmessages": true,
        "messages": [
            {
                "name": "Nandika",
                "time": "Wednesday, 14 October 2026, 10:32 AM",
                "message": "Hello everyone!",
                "candelete": true,
                "deleteurl": "https://example.com/local/helloworld/index.php?delete=1"
            }
        ]
    }
}}
<h3>{{#str}} allmessages, local_helloworld {{/str}}</h3>
{{#hasmessages}}
    <ul class="list-group">
        {{#messages}}
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div>
                    <strong>{{name}}</strong>
                    <small class="text-muted ms-2">{{time}}</small>
                    <p class="mb-0">{{message}}</p>
                </div>
                {{#candelete}}
                    <a href="{{deleteurl}}">
                        {{#pix}} t/delete, core, {{#str}} delete {{/str}} {{/pix}}
                    </a>
                {{/candelete}}
            </li>
        {{/messages}}
    </ul>
{{/hasmessages}}
{{^hasmessages}}
    <p>{{#str}} nomessages, local_helloworld {{/str}}</p>
{{/hasmessages}}
